# Copy to .env for local development outside Docker Compose.
#
# Compose supplies these itself, so this file is only needed when running a
# service directly with `pnpm --filter @oat/telemetry-api dev`.
#
# There are no real credentials here and there never should be. .env is
# gitignored; this file is not.

NODE_ENV=development
LOG_LEVEL=debug

# --- PostgreSQL -------------------------------------------------------------
# Local container. On AWS this comes from Secrets Manager, never from a file.
DATABASE_URL=postgres://oat:oat@localhost:5432/oat
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# --- Kafka ------------------------------------------------------------------
# 29092 is the listener the broker advertises to the host; containers use 9092.
KAFKA_BROKERS=localhost:29092
# plaintext for a local broker. aws-msk-iam for MSK, where the pod's IAM role is
# the credential and there is no password.
KAFKA_AUTH=plaintext
AWS_REGION=ca-central-1

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_URL=amqp://oat:oat@localhost:5672

# --- Telemetry API ----------------------------------------------------------
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=*
RUN_MIGRATIONS=true
# mock returns clearly-labelled placeholder figures for the AWS estate.
# aws would read CloudWatch and the EKS API — not yet implemented.
INFRASTRUCTURE_PROVIDER=mock

# --- Other services ---------------------------------------------------------
# Probe ports. Each service serves /health, /ready and /metrics here.
HEALTH_PORT=8081
PREFETCH=1
API_BASE_URL=http://localhost:8080
SEED=20260825

# --- Web client -------------------------------------------------------------
# Empty means same origin, which is what the dev proxy and the nginx container
# both rely on.
VITE_API_BASE_URL=
